generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  PICKER
  RIDER
  MANAGER
  ADMIN
}

enum OrderStatus {
  AWAITING_PAYMENT
  CONFIRMED
  ACCEPTED
  PICKING
  PACKED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  PAYMENT_FAILED
  RETURN_REQUESTED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUND_PENDING
  REFUNDED
}

model User {
  id                  String               @id @default(cuid())
  name                String?
  email               String               @unique
  emailVerified       DateTime?
  image               String?
  passwordHash        String?
  role                Role                 @default(CUSTOMER)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  orders              Order[]
  deliveryAssignments DeliveryAssignment[] @relation("RiderAssignments")
  accounts            Account[]
  sessions            Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  products Product[]
}

model Product {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  description String           @db.Text
  categoryId  String
  active      Boolean          @default(true)
  imageKey    String           @default("")
  origin      String           @default("Local partner counter")
  category    Category         @relation(fields: [categoryId], references: [id])
  variants    ProductVariant[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([categoryId, active])
}

model ProductVariant {
  id          String      @id @default(cuid())
  productId   String
  sku         String      @unique
  label       String
  weightGrams Int
  pricePaise  Int
  stockGrams  Int         @default(0)
  prepOptions String[]
  active      Boolean     @default(true)
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]

  @@index([productId, active])
}

model DeliverySlot {
  id            String   @id @default(cuid())
  startsAt      DateTime
  endsAt        DateTime
  capacity      Int
  reservedCount Int      @default(0)
  areaCode      String
  active        Boolean  @default(true)
  orders        Order[]

  @@index([areaCode, startsAt, active])
}

model Order {
  id                       String               @id @default(cuid())
  orderNumber              String               @unique
  idempotencyKey           String               @unique
  userId                   String
  slotId                   String
  status                   OrderStatus          @default(CONFIRMED)
  paymentStatus            PaymentStatus        @default(PENDING)
  paymentMethod            String               @default("COD")
  paymentProviderOrderId   String?              @unique
  paymentProviderPaymentId String?              @unique
  paymentProviderRefundId  String?              @unique
  paymentFailureCode       String?
  subtotalPaise            Int
  deliveryPaise            Int
  totalPaise               Int
  addressJson              Json
  instructions             String               @default("")
  expiresAt                DateTime?
  user                     User                 @relation(fields: [userId], references: [id])
  slot                     DeliverySlot         @relation(fields: [slotId], references: [id])
  items                    OrderItem[]
  history                  OrderStatusHistory[]
  assignment               DeliveryAssignment?
  paymentEvents            PaymentEvent[]
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model PaymentEvent {
  id        String   @id @default(cuid())
  provider  String
  eventId   String
  eventType String
  orderId   String?
  createdAt DateTime @default(now())
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([provider, eventId])
  @@index([orderId, createdAt])
}

model RateLimitBucket {
  key             String   @id
  windowStartedAt DateTime
  attempts        Int      @default(0)

  @@index([windowStartedAt])
}

model OrderItem {
  id             String          @id @default(cuid())
  orderId        String
  variantId      String?
  productName    String
  variantLabel   String
  preparation    String
  quantity       Int
  weightGrams    Int
  unitPricePaise Int
  lineTotalPaise Int
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  actorId   String?
  note      String      @default("")
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model DeliveryAssignment {
  id         String   @id @default(cuid())
  orderId    String   @unique
  riderId    String
  assignedAt DateTime @default(now())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rider      User     @relation("RiderAssignments", fields: [riderId], references: [id], onDelete: Restrict)

  @@index([riderId, assignedAt])
}
